{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
		    "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "LegacyInfantry",
            "displayName": "老步兵配置 (DM 底盘 + DM MIT 云台 + SBUS)",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build/legacy",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "H7_LEGACY_INFANTRY": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "LegacyInfantry",
            "configurePreset": "LegacyInfantry"
        }
    ]
}